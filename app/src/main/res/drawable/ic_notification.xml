<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_notification.xml — MountX Status Bar Notification Icon
    Single-color white vector silhouette on transparent background.
    Android 5+ requires notification icons to be single-color (do NOT use ?attr/ references).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- External storage base (disk/SD body) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,14L4,19Q4,20 5,20L19,20Q20,20 20,19L20,14Q20,13 19,13L5,13Q4,13 4,14Z" />

    <!-- Storage LED indicator cutout (inset punch) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M10.5,15.5L13.5,15.5L13.5,18.5L10.5,18.5Z" />

    <!-- Mount arrow shaft (vertical, pointing up) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11,4L13,4L13,12L11,12Z" />

    <!-- Mount arrow head (chevron pointing up) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,1.5L6.5,7L8,8.5L12,4.5L16,8.5L17.5,7Z" />

</vector>
